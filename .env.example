# Postgres connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL=

# Random 32+ char string used to sign login links and session cookies
AUTH_SECRET=

# Base URL of this app, used to build every link in the emails (e.g. http://localhost:3000 locally)
APP_BASE_URL=

# Only @<this domain> addresses can submit a request (defaults to autochek.africa)
EMPLOYEE_EMAIL_DOMAIN=

# Emails are sent through the template-mgt service.
# Auth service: the app logs in here to get a bearer token
AUTH_LOGIN_URL=
TEMPLATE_API_USERNAME=
TEMPLATE_API_PASSWORD=
# Template service base URL
TEMPLATE_API_BASE_URL=

# Optional: secret for the retry endpoint /api/jobs/emails (Vercel Cron sends it automatically)
CRON_SECRET=
# Optional: seconds before the first email retry (doubles each attempt, 5 attempts). Default 30
EMAIL_RETRY_BASE_SECONDS=
# Optional: how long (seconds) the worker waits for retries after an action. Default 8
EMAIL_WORKER_BUDGET_SECONDS=
