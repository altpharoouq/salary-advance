# Postgres connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Random 32+ char string used to sign login links and session cookies
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed app (used in emails and login links)
APP_URL=http://localhost:3000

# SMTP for notifications + login links (e.g. Gmail app password, Resend SMTP, etc.)
# If SMTP_HOST is empty, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Salary Advance <noreply@autochek.africa>"
EMPLOYEE_EMAIL_DOMAIN=autochek.africa
